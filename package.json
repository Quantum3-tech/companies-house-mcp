{
  "name": "companies-house-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing UK Companies House data to Claude",
  "license": "MIT",
  "type": "module",
  "bin": {
    "companies-house-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env LIVE_API_TESTS=1 vitest run",
    "capture": "tsx scripts/capture-fixtures.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
